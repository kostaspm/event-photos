# Copy this file to .env.local for local development with `vercel dev`
# In production, set these in the Vercel dashboard → Project → Settings → Environment Variables

# ── Google OAuth 2.0 credentials ──────────────────────────────────────────────
# Create a project at https://console.cloud.google.com/
# Enable the "Google Photos Library API"
# Create OAuth 2.0 credentials (type: Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# One-time: run the OAuth helper to get this refresh token (see README)
GOOGLE_REFRESH_TOKEN=
# ── Google Drive folder ──────────────────────────────────────────────────────
# The ID of the Drive folder guests' uploads will land in.
# Create a folder in Google Drive, copy its ID from the URL:
# https://drive.google.com/drive/folders/THIS_IS_THE_ID
GOOGLE_FOLDER_ID=